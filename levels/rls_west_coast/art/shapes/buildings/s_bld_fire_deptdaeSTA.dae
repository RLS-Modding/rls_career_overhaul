                  <instance_material symbol="brick_painted-material" target="#brick_painted-material">
                    <bind_vertex_input semantic="Mesh-mesh-map-0" input_semantic="TEXCOORD" input_set="0"/>
                    <bind_vertex_input semantic="Mesh-mesh-map-1" input_semantic="TEXCOORD" input_set="1"/>
                    <bind_vertex_input semantic="Mesh-mesh-map-2" input_semantic="TEXCOORD" input_set="2"/>
                  </instance_material>
                </technique_common>
              </bind_material>
            </instance_geometry>
          </node>
        </node>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#Scene"/>
  </scene>
</COLLADA>