{
//JBeam fully inspired by drowsysam
"wheel_dyno_rls_R5": {
    "information":{
        "authors":"Necronomic",
        "name":"RLS Hub Dyno",
        "value":1400,
    },
    "slotType" : ["wheel_R_4", "wheel_R_5", "wheel_R_6", "wheel_R_8", "wheel_R_centerlug"],
    "slots": [
        ["type", "default", "description"],
        ["rls_hubdyno_case_R","rls_hubdyno_case_R", "Rear Dyno Casing"],
    ],
    "variables": [
        ["name", "type", "unit", "category",    "default", "min", "max", "stepDis", "title",         "description"],
        ["$variablePosR", "range", "cm", "Dyno",    0,       0,   20,     0.1,     "Rear Hub Offset", "Length of the Rear Axle and Hub in cm", {"subCategory":"Dyno Hubs"}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        //RR
        ["rls_hubdyno_frame", ["box_r"], [], {"pos":{"x":-1.28, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1.00, "y":1.0, "z":1.0}}],
        ["rls_hubdyno_rotor_mount", ["box_r"], [], {"pos":{"x":-1.28, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1.00, "y":1.0, "z":1.0}}],
        ["rls_hubdyno_feet", ["box_r"], [], {"pos":{"x":-1.28, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1.00, "y":1.0, "z":1.0}}],
        ["rls_hubdyno_rotor", ["wheel_RR","wheelhub_RR"], [], {"pos":{"x":-1.28, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1.00, "y":1.0, "z":1.0}}],
        ["rls_hubdyno_rotor_hub", ["wheel_RR","wheelhub_RR"], [], {"pos":{"x":"$=$components.DynoHubPosRR.X - 1.28", "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1.00, "y":1.0, "z":1.0}}],
        //RL
        ["rls_hubdyno_frame", ["box_l"], [], {"pos":{"x":1.28, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.00, "y":1.0, "z":1.0}}],
        ["rls_hubdyno_rotor_mount", ["box_l"], [], {"pos":{"x":1.28, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.00, "y":1.0, "z":1.0}}],
        ["rls_hubdyno_feet", ["box_l"], [], {"pos":{"x":1.28, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.00, "y":1.0, "z":1.0}}],
        ["rls_hubdyno_rotor", ["wheel_RL","wheelhub_RL"], [], {"pos":{"x":1.28, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.00, "y":1.0, "z":1.0}}],
        ["rls_hubdyno_rotor_hub", ["wheel_RL","wheelhub_RL"], [], {"pos":{"x":"$=$components.DynoHubPosRL.X + 1.28", "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.00, "y":1.0, "z":1.0}}],

        //alloy wheels
        //["ravix_wheel_20x11", ["wheel_RR","wheelhub_RR"], [], {"materialOverride":[["ravix_wheel_base","$=$components.ravix_wheel_paint_R.ravix_wheel_paint_R_base == nil and 'nopaintR' or $components.ravix_wheel_paint_R.ravix_wheel_paint_R_base"]], "pos":{"x":-0.5, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1.03, "y":1.0, "z":1.0}}],
        //["ravix_wheel_20x11", ["wheel_RL","wheelhub_RL"], [], {"materialOverride":[["ravix_wheel_base","$=$components.ravix_wheel_paint_R.ravix_wheel_paint_R_base == nil and 'nopaintR' or $components.ravix_wheel_paint_R.ravix_wheel_paint_R_base"]], "pos":{"x": 0.5, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":0},   "scale":{"x":1.03, "y":1.0, "z":1.0}}],
    ],
    "components": {
        "DynoHubPosRR": {
           "X": "$=$variablePosR *   0.01",
        },
        "DynoHubPosRL": {
           "X": "$=$variablePosR * - 0.01",
        },
    },
	"rotators":
	[
		["name","[group]:","node1:","node2:","nodeArm:","wheelDir"],
		{"radius":0.34},
		//not intentional
		{"propulsed":0},
		{"brakeTorque":4000,"parkingTorque":4000,"enableBrakeThermals":false},
		{"brakeSpring":125},
		{"axleBeams":["rw1r", "rw1rr"]},
        ["RR", ["wheel_RR"], "rw1r", "rw1rr", "rw1rr", -1],
		{"axleBeams":["rw1l", "rw1ll"]},
        ["RL", ["wheel_RL"], "rw1l", "rw1ll", "rw1ll", 1],
