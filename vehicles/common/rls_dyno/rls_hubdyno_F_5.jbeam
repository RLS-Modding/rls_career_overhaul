{
//JBeam fully inspired by drowsysam
"wheel_dyno_rls_F5": {
    "information":{
        "authors":"Necronomic",
        "name":"RLS Hub Dyno Front",
        "value":1400,
    },
    "slotType" : ["wheel_F_4", "wheel_F_5", "wheel_F_6", "wheel_F_8", "wheel_F_centerlug"],
    "slots": [
        ["type", "default", "description"],
        ["rls_hubdyno_case_F","rls_hubdyno_case_F", "Front Dyno Casing"],
    ],
    "variables": [
        ["name", "type", "unit", "category",    "default", "min", "max", "stepDis", "title",         "description"],
        ["$variablePosF", "range", "cm", "Dyno",    0,       0,   20,     0.1,     "Front Hub Offset", "Length of the Front Axle and Hub in cm", {"subCategory":"Dyno Hubs"}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        //FR
        ["rls_hubdyno_frame", ["fbox_r"], [], {"pos":{"x":-1.28, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1.00, "y":1.0, "z":1.0}}],
        ["rls_hubdyno_rotor_mount", ["fbox_r"], [], {"pos":{"x":-1.28, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1.00, "y":1.0, "z":1.0}}],
