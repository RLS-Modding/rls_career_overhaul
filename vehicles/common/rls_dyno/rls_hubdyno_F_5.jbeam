        ["rls_hubdyno_rotor_hub", ["wheel_FR","wheelhub_FR"], [], {"pos":{"x":"$=$components.DynoHubPosFR.X - 1.28", "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1.00, "y":1.0, "z":1.0}}],
        //FL
        ["rls_hubdyno_frame", ["fbox_l"], [], {"pos":{"x":1.28, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.00, "y":1.0, "z":1.0}}],
        ["rls_hubdyno_rotor_mount", ["fbox_l"], [], {"pos":{"x":1.28, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.00, "y":1.0, "z":1.0}}],
        ["rls_hubdyno_feet", ["fbox_l"], [], {"pos":{"x":1.28, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.00, "y":1.0, "z":1.0}}],
        ["rls_hubdyno_rotor", ["wheel_FL","wheelhub_FL"], [], {"pos":{"x":1.28, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.00, "y":1.0, "z":1.0}}],
        ["rls_hubdyno_rotor_hub", ["wheel_FL","wheelhub_FL"], [], {"pos":{"x":"$=$components.DynoHubPosFL.X + 1.28", "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.00, "y":1.0, "z":1.0}}],
    ],
    "components": {
        "DynoHubPosFR": {
           "X": "$=$variablePosF *   0.01",
        },
        "DynoHubPosFL": {
           "X": "$=$variablePosF * - 0.01",
        },
    },
